# STAGING environment — copy to staging.env and fill in real values
BASE_URL=https://staging.your-hrm-instance.com
USERNAME=<staging-admin-username>
PASSWORD=<staging-admin-password>
HEADLESS=true
SLOW_MO=0
TIMEOUT=60000
EXPECT_TIMEOUT=30000
ACTION_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000
RETRIES=2
WORKERS=4
