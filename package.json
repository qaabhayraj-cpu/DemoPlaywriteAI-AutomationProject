{
  "name": "orangehrm-playwright",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --grep @api",
    "test:visual": "playwright test tests/visual/",
    "test:a11y": "playwright test tests/a11y/",
    "test:network": "playwright test tests/network/",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:headed": "HEADLESS=false playwright test",
    "test:headed:chrome": "HEADLESS=false playwright test --project=chromium",
    "test:headed:firefox": "HEADLESS=false playwright test --project=firefox",
    "test:headed:webkit": "HEADLESS=false playwright test --project=webkit",
    "test:headless": "HEADLESS=true playwright test",
    "test:debug": "HEADLESS=false PWDEBUG=1 playwright test",
    "test:ui": "playwright test --ui",
    "test:slow": "HEADLESS=false SLOW_MO=500 playwright test",
    "test:docker": "docker-compose -f docker/docker-compose.yml up --abort-on-container-exit",
    "test:env:dev": "TEST_ENV=dev playwright test",
    "test:env:qa": "TEST_ENV=qa playwright test",
    "test:env:staging": "TEST_ENV=staging playwright test",
    "test:update-snapshots": "playwright test tests/visual/ --update-snapshots",
    "test:shard:1": "playwright test --shard=1/3",
    "test:shard:2": "playwright test --shard=2/3",
    "test:shard:3": "playwright test --shard=3/3",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report:junit": "cat test-results/junit.xml",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "flaky-report": "ts-node scripts/flaky-report.ts",
    "generate-env-report": "ts-node scripts/generate-env-report.ts",
    "prepare": "husky install",
    "pre-commit": "lint-staged"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@faker-js/faker": "^8.0.2",
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "allure-commandline": "^2.15.0",
    "allure-playwright": "^2.0.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-playwright": "^1.0.0",
    "fast-xml-parser": "^4.0.0",
    "husky": "^9.0.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.6.0",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@playwright/mcp": "^0.0.75"
  }
}
